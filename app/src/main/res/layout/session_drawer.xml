<?xml version="1.0" encoding="utf-8"?>
<!--
    The in-session drawer, opened with Back. A tap on the dimmed area or Back again closes it.
    Small on purpose: the switches a player reaches for mid-game, nothing that needs the main
    screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#F2151A22"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/drawer_hud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/drawer_hud"
            android:textColor="#FFDDDDDD"
            android:textSize="13sp" />

        <Button
            android:id="@+id/drawer_frame_gen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/drawer_osc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="40dp"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/drawer_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:textSize="13sp"
            android:text="@string/drawer_background" />

        <Button
            android:id="@+id/drawer_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="40dp"
            android:textSize="13sp"
            android:textColor="#FFFF8A80"
            android:text="@string/stop_session" />
    </LinearLayout>
</FrameLayout>
